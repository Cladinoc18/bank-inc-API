{
  "info": {
    "_postman_id": "b71e1948-c89b-4e08-9df2-9b2401f89312",
    "name": "Bank Inc API - CredibanCo (Con Seguridad RBAC)",
    "description": "Colección completa de pruebas para la API bancaria de Bank Inc (CredibanCo). Incluye emisión, enrolamiento, bloqueo, recarga, consulta de saldo, compras, consulta de transacciones, anulación y autenticación de canales por API Keys.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "admin-bank-key-123",
      "type": "string"
    },
    {
      "key": "clientApiKey",
      "value": "client-app-key-789",
      "type": "string"
    },
    {
      "key": "merchantApiKey",
      "value": "merchant-pos-key-456",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "102030",
      "type": "string"
    },
    {
      "key": "cardId",
      "value": "1020301234567801",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "102030",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Clientes (Seed / Gestión - Canal ADMIN)",
      "item": [
        {
          "name": "Listar Clientes (Obtener clientId semilla)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client",
              "host": ["{{baseUrl}}"],
              "path": ["client"]
            },
            "description": "Retorna los clientes existentes, incluyendo el cliente semilla inicial (Juan Pérez) para usar su ID en el enroll de tarjeta."
          },
          "response": []
        },
        {
          "name": "Crear Nuevo Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"Rodríguez\",\n  \"documentNumber\": \"1098765432\",\n  \"email\": \"carlos.rodriguez@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/client",
              "host": ["{{baseUrl}}"],
              "path": ["client"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Tarjetas (/card)",
      "item": [
        {
          "name": "1. Generar número de tarjeta [ADMIN]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/card/{{productId}}/number",
              "host": ["{{baseUrl}}"],
              "path": ["card", "{{productId}}", "number"]
            },
            "description": "Genera una tarjeta de 16 dígitos a partir del productId de 6 dígitos. La tarjeta nace inactiva y con saldo 0."
          },
          "response": []
        },
        {
          "name": "2. Activar tarjeta (Enroll con Cliente) [ADMIN]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"{{cardId}}\",\n  \"clientId\": \"{{clientId}}\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/card/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["card", "enroll"]
            },
            "description": "Asigna el cliente a la tarjeta completando el nombre del titular, asignando el PIN de seguridad y activando la tarjeta para que pueda operar."
          },
          "response": []
        },
        {
          "name": "3. Consultar detalle de la tarjeta [ADMIN / CLIENT]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/card/{{cardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["card", "{{cardId}}"]
            },
            "description": "Permite verificar que la tarjeta tenga todos los campos asignados y completos (titular, vencimiento, estado, etc.)."
          },
          "response": []
        },
        {
          "name": "4. Recargar saldo [CLIENT]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{clientApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"{{cardId}}\",\n  \"balance\": \"10000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/card/balance",
              "host": ["{{baseUrl}}"],
              "path": ["card", "balance"]
            },
            "description": "Recarga el saldo de la tarjeta en dólares USD de forma atómica."
          },
          "response": []
        },
        {
          "name": "5. Consulta de saldo [CLIENT]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{clientApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/card/balance/{{cardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["card", "balance", "{{cardId}}"]
            },
            "description": "Consulta el saldo disponible y estado de la tarjeta."
          },
          "response": []
        },
        {
          "name": "6. Bloquear tarjeta [ADMIN / CLIENT]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{clientApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/card/{{cardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["card", "{{cardId}}"]
            },
            "description": "Bloquea la tarjeta impidiendo que se realicen futuras recargas o transacciones. Puede ser ejecutado por el tarjetahabiente (CLIENT) o por el administrador (ADMIN)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Transacciones (/transaction)",
      "item": [
        {
          "name": "1. Transacción de compra [CLIENT]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{clientApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"{{cardId}}\",\n  \"price\": 100,\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/purchase",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "purchase"]
            },
            "description": "Realiza una compra descontando el saldo de manera transaccional ACID, validando estado activo, no bloqueado, vigencia, PIN de seguridad de 4 dígitos y fondos."
          },
          "response": []
        },
        {
          "name": "2. Consultar transacción por ID [MERCHANT / CLIENT]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{merchantApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transaction/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "{{transactionId}}"]
            },
            "description": "Obtiene el detalle completo de la transacción realizada."
          },
          "response": []
        },
        {
          "name": "3. Anulación de transacción [MERCHANT]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{merchantApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"{{cardId}}\",\n  \"transactionId\": \"{{transactionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/anulation",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "anulation"]
            },
            "description": "Anula la transacción si tiene menos de 24 horas y reintegra el dinero inmediatamente al saldo disponible de la tarjeta."
          },
          "response": []
        }
      ]
    }
  ]
}
